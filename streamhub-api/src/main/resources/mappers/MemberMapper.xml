<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.streamhub.api.v1.member.mapper.MemberMapper">

    <!--
        Shared filter block: keyword (name/email/phone), status, church.

        The keyword branches by input shape instead of running one OR across all three columns with
        a leading wildcard. That form is unindexable — a leading '%' rules out the B-tree, and the OR
        rules out an index merge — so every search, and its COUNT(*) twin, full-scanned MEMBER twice.

        Now: an input containing '@' searches email by prefix, an all-digits input searches phone by
        its digits, and anything else searches name. Prefix matches use idx_member_email /
        idx_member_phone / idx_member_name. Name keeps the leading wildcard because Korean names are
        routinely searched by their last two characters and a prefix-only match would be useless —
        that one is a deliberate scan, not an oversight, and it is now the only one.
    -->
    <sql id="searchWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                <!-- Double quotes on purpose: OGNL reads a single-quoted one-character literal as a
                     java.lang.Character, and String.contains needs a CharSequence. -->
                <choose>
                    <when test='keyword.contains("@")'>
                        AND m.email LIKE CONCAT(#{keyword}, '%')
                    </when>
                    <when test='keyword.matches("[0-9-]+")'>
                        AND m.phone LIKE CONCAT(#{keyword}, '%')
                    </when>
                    <otherwise>
                        AND m.name LIKE CONCAT('%', #{keyword}, '%')
                    </otherwise>
                </choose>
            </if>
            <if test="userStatus != null and userStatus != ''">
                AND m.user_status = #{userStatus}
            </if>
            <if test="churchId != null">
                AND m.church_id = #{churchId}
            </if>
        </where>
    </sql>

    <select id="selectList" resultType="org.streamhub.api.v1.member.dto.MemberListItem">
        SELECT
            m.id                AS id,
            m.name              AS name,
            m.email             AS email,
            m.phone             AS phone,
            m.user_status       AS user_status,
            m.live_yn           AS live_yn,
            m.grade             AS grade,
            m.point_balance     AS point_balance,
            m.church_id         AS church_id,
            c.name              AS church_name,
            r.name              AS region_name,
            co.name             AS country_name,
            m.created_at        AS created_at
        FROM MEMBER m
            JOIN CHURCH c   ON m.church_id = c.id
            JOIN REGION r   ON c.region_id = r.id
            JOIN COUNTRY co ON r.country_id = co.id
        <include refid="searchWhere"/>
        ORDER BY ${orderBy}
        LIMIT #{offset}, #{size}
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*)
        FROM MEMBER m
        <include refid="searchWhere"/>
    </select>

    <select id="selectDetail" resultType="org.streamhub.api.v1.member.dto.MemberDetail">
        SELECT
            m.id                AS id,
            m.name              AS name,
            m.email             AS email,
            m.phone             AS phone,
            m.user_status       AS user_status,
            m.live_yn           AS live_yn,
            m.grade             AS grade,
            m.point_balance     AS point_balance,
            m.church_id         AS church_id,
            c.name              AS church_name,
            r.id                AS region_id,
            r.name              AS region_name,
            co.id               AS country_id,
            co.name             AS country_name,
            m.created_at        AS created_at,
            m.updated_at        AS updated_at
        FROM MEMBER m
            JOIN CHURCH c   ON m.church_id = c.id
            JOIN REGION r   ON c.region_id = r.id
            JOIN COUNTRY co ON r.country_id = co.id
        WHERE m.id = #{id}
    </select>

</mapper>
